 "cle": [
  {
   "num": 1,
   "titre": "La statue du Fondateur",
   "desc": "Un marchand de pierre, la main tendue vers la Porte Nord. Le socle dallé sert de tribune au crieur public le matin, et de perchoir aux gamins le reste du jour. Une inscription usée : « À celui qui ouvrit la route ». Fouiller la base (DD moyen) révèle une cache où les voleurs à la tire déposent leurs prises en attendant le soir."
  },
  {
   "num": 2,
   "titre": "Les étals",
   "desc": "Onze échoppes tournées vers le centre : maraîchers et volailles au sud, poissons et sel à l’est, drapiers et cuirs à l’ouest, camelots au nord — c’est là qu’on trouve du douteux. Les prix baissent d’un quart la dernière heure avant la fermeture."
  },
  {
   "num": 3,
   "titre": "La Porte Nord",
   "desc": "Deux tours et un passage de trois pas. Quatre gardes de faction, un sergent qui note les entrées. Péage d’un sou par charrette. Ils ferment au crépuscule ; après, il faut payer — ou connaître quelqu’un."
  },
  {
   "num": 4,
   "titre": "Les charrettes des maraîchers",
   "desc": "Elles arrivent avant l’aube et repartent à midi. Se glisser dessous est le moyen le plus simple de sortir de la ville sans être vu (DD facile si l’on a distrait le charretier)."
  },
  {
   "num": 5,
   "titre": "La foule",
   "desc": "Une trentaine de personnes en permanence, le triple les jours de marché. Toute poursuite ici se fait à mi-vitesse. Trois tire-laine opèrent en trio : l’un bouscule, l’autre coupe la bourse, le troisième l’emporte vers la Ville basse."
  }
 ],
 "pins": [],
