 "cle": [
  {
   "num": 1,
   "titre": "Le Traiteur du Cygne",
   "desc": "Maître Ombeline fournit les tables de la Ville haute. Cuisine ouverte sur la cour, six commis, un livre de commandes qui dit exactement qui reçoit qui, et quand — le document le plus indiscret du quartier. Elle le prête à qui la fait rire ; elle le vend à personne."
  },
  {
   "num": 2,
   "titre": "Herboristerie Belladone",
   "desc": "Simples, onguents, et sous le comptoir de quoi faire dormir un cheval. Le vieil Absalon ne pose pas de questions mais note tout dans un registre chiffré. Vend un antidote universel hors de prix (40 po) qui fonctionne vraiment."
  },
  {
   "num": 3,
   "titre": "Orfèvrerie Vandelle",
   "desc": "Pièce unique en vitrine, deux gardes en livrée, coffre scellé au sol. On n’entre que sur recommandation. Vandelle estime et rachète — sans certificat, à un cinquième du prix, et il se souvient des visages."
  },
  {
   "num": 4,
   "titre": "Soieries d’Orient",
   "desc": "Étoffes venues par la Porte Nord. L’arrière-boutique sert de salon où l’on parle affaires à voix basse ; le patron loue la pièce à l’heure et ne veut rien savoir de ce qui s’y dit."
  },
  {
   "num": 5,
   "titre": "Parfumeur Lisandre",
   "desc": "Sait reconnaître un parfum sur un vêtement et dire à qui on l’a vendu. Une piste vivante pour un enquêteur — Lisandre parle volontiers, par vanité."
  },
  {
   "num": 6,
   "titre": "Hôtel de Rosemont",
   "desc": "La grille est fermée, la cour plantée, le logis en retrait. La baronne de Rosemont reçoit trois fois la semaine. Deux hommes d’armes privés, une porte de service au nord par la ruelle. Escalader la grille : DD moyen, et les voisins regardent toujours."
  },
  {
   "num": 7,
   "titre": "La fontaine et les dames",
   "desc": "Trois dames de la haute s’y retrouvent chaque après-midi pour badiner : Ysolde de Marsan, la jeune veuve Célie, et une cousine dont personne ne retient le nom. Elles savent tout du quartier avant tout le monde et le racontent à qui les amuse. Un PJ bien mis en tire trois rumeurs vraies et une fausse ; un PJ mal mis se fait éconduire — et signaler."
  },
  {
   "num": 8,
   "titre": "Le guet privé",
   "desc": "Le quartier paie sa propre patrouille : deux hommes, une ronde toutes les vingt minutes. Ils ne verbalisent pas, ils raccompagnent — fermement — quiconque n’a pas l’air d’avoir les moyens d’être là."
  }
 ],
