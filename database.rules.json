{
  "rules": {
    ".read": false,
    ".write": false,

    "parties": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('mj').val() === auth.uid : auth.token.firebase.sign_in_provider === 'password')",

        "joueurs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "mouvements": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "$autre": {
          ".validate": true
        }
      }
    },

    "mj": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    }
  }
}
