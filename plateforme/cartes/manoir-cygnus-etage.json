  "cle": [
    {
      "num": 5,
      "titre": "Haut des escaliers jumeaux",
      "desc": "Les deux volées débouchent sur le palier sud ; face aux PJ pendant toute la montée, le grand tableau familial accroché au mur épais du laboratoire. Secret : il recouvre la trappe percée dans le mur — accès dérobé au laboratoire, et c'est par là que l'on rejoint l'escalier caché qui descend à la cave. Le couloir n'a aucune fenêtre."
    },
    {
      "num": 6,
      "titre": "Chambre d'enfant (ouest)",
      "desc": "Première des trois chambres ouest, rigoureusement identiques : lit, coffre."
    },
    {
      "num": 7,
      "titre": "Chambre d'enfant (ouest)",
      "desc": "Deuxième chambre ouest, identique à la précédente."
    },
    {
      "num": 8,
      "titre": "Chambre d'enfant (ouest)",
      "desc": "Troisième chambre ouest, identique aux précédentes."
    },
    {
      "num": 9,
      "titre": "Chambre d'enfant (est)",
      "desc": "Quatrième chambre des quintuplés, mêmes meubles, même disposition."
    },
    {
      "num": 10,
      "titre": "Chambre d'enfant (est)",
      "desc": "Cinquième chambre. Un seul détail devrait différer d'une chambre à l'autre — au MJ de choisir lequel, et pourquoi."
    },
    {
      "num": 11,
      "titre": "Laboratoire & débarras",
      "desc": "Pièce aveugle au cœur de l'étage, aux murs anormalement épais ; une seule porte, à l'arrière, face à la chambre du maître. On y prépare les remèdes des quintuplés… et c'est ici que le somnifère a été fabriqué. Fioles, mortier taché, notes de dosage."
    },
    {
      "num": 12,
      "titre": "Chambre du maître",
      "desc": "Chambre du père de famille"
    }
  ],
